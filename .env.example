# Copy to .env.local and fill in your own key.
GEMINI_API_KEY=

# Optional overrides
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MINUTES=10

# Optional: email action plans via n8n. Use the PRODUCTION webhook URL (the one
# containing /webhook/, not /webhook-test/). Leave empty to hide the email box.
N8N_WEBHOOK_URL=
# Optional shared secret sent as the x-careeros-secret header.
# N8N_WEBHOOK_SECRET=

# Optional: job search in India via Adzuna (free keys at https://developer.adzuna.com/signup).
# Without these, the Shortlister still finds remote jobs from Remotive.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: Google sign-in and saved progress via Supabase (supabase.com, free).
# Both values are public by design. Without them the app runs in guest mode and hides sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
